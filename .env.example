# Copia a .env solo para correr local sin `npm run dev`. En Cloud Run estos valores
# llegan por Secret Manager (MP_SECRET, MP_TOKENS) y por el entorno (PORT, proyecto).
PORT=8080
DATA_BACKEND=memory            # memory | firestore
DATA_FILE=.datos-dev.json      # solo backend memory: persiste en este archivo (opcional)
MP_SECRET=cambia-esto-por-32-bytes-aleatorios
MP_TOKENS=pablo:<token>,max:<token>,daniel:<token>   # genera con: npm run tokens
# GOOGLE_CLOUD_PROJECT=mindprint-tablero  # backend firestore fuera de Cloud Run
